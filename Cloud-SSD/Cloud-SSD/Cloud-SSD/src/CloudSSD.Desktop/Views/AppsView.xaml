<UserControl x:Class="CloudSSD.Desktop.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0,0,14,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Look again" Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                    IsEnabled="{Binding Loading, Converter={StaticResource NotVis}}" />
            <TextBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Padding="8,5"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type a name to find a program" />
            <StackPanel>
                <TextBlock Text="Start any program from here. No folder to choose: the list fills by itself." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding Moving, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding StopLabel}" Command="{Binding StopMoveCommand}" Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{Binding MoveStatus}" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding MoveFraction}" Maximum="1" Margin="0,8,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="No program with that name." Style="{StaticResource Caption}" Margin="0,0,0,8"
                   Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
        <ListBox ItemsSource="{Binding Apps}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" Margin="0,0,12,0">
                            <Border CornerRadius="20" Background="{DynamicResource PurpleSoft}" Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}">
                                <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Purple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Source="{Binding Icon}" Width="32" Height="32" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding WhereText}" FontSize="11.5" Foreground="{Binding WhereTone, Converter={StaticResource Tone}}" />
                        </Border>
                        <Button Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0" Padding="10,4" Content="{Binding MoveText}" ToolTip="{Binding MoveTip}"
                                ToolTipService.ShowOnDisabled="True" IsEnabled="{Binding CanMove}" Visibility="{Binding ShowMove, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                        <Button Grid.Column="4" Style="{StaticResource Ghost}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="10,4"
                                Content="{Binding DataContext.GameLabel, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                Command="{Binding DataContext.PlayAsGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                        <Button Grid.Column="5" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="14,4" MinWidth="76"
                                Content="{Binding DataContext.OpenLabel, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
