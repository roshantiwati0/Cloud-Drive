<Window x:Class="CloudSSD.Desktop.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a device" Width="720" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26,22">
        <TextBlock Text="Add a device" Style="{StaticResource H1}" />
        <TextBlock Text="Pairing works only on the same Wi-Fi or hotspot. After that it also works away from home through Tailscale, if you allow it."
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Phone or tablet: QR code + code -->
            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Phone or tablet" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="Scan the QR code with the phone, or type this code in the Cloud-SSD app:" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Border Width="190" Height="190" Background="White" CornerRadius="14" Padding="8" HorizontalAlignment="Center"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                        <Image x:Name="Qr" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Laptop or PC: address + code -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Laptop or PC" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="On the other laptop open Cloud-SSD → Other PCs → + Add a PC, then type this PC's address and the code."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="This PC's address" Style="{StaticResource Label}" />
                    <TextBox x:Name="Address" IsReadOnly="True" FontFamily="Consolas" FontSize="14" Margin="0,0,0,14" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- The code, shared by both -->
        <Border Background="{DynamicResource Surface2}" CornerRadius="16" Padding="14,12" Margin="0,16,0,0"
                BorderBrush="{DynamicResource Accent}" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="PAIRING CODE" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                <TextBlock x:Name="Code" FontFamily="Consolas" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                <TextBlock Text="The code changes after it is used once." FontSize="11" Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Hotspot / USB cable: one firewall rule; and a reminder on a public network -->
        <Border x:Name="DirectBox" Visibility="Collapsed" Background="{DynamicResource Surface2}" CornerRadius="16" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <Button x:Name="DirectButton" DockPanel.Dock="Right" Content="Allow" Click="AllowDirect" Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="To connect over this PC's hotspot, a phone's hotspot or a USB cable, Windows' firewall must let phones on those networks in (Windows asks once)."
                           TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="PublicNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Warning}" Margin="0,10,0,0"
                   Text="Windows treats this Wi-Fi as a public network. Pair only on networks you trust: your home, your own hotspot or a USB cable." />

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Margin="0" />
            <TextBlock x:Name="Status" Text="Waiting for a device…" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Muted}" />
        </DockPanel>
    </StackPanel>
</Window>
