<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark palette: "Midnight", dark navy with teal, like the phone app. Light.xaml defines exactly the same keys; ThemeManager swaps one for the other at run time, and
        every view refers to these brushes with DynamicResource so the switch is instant.
    -->
    <Color x:Key="BgColor">#0B0F17</Color>
    <Color x:Key="SurfaceColor">#121826</Color>
    <Color x:Key="Surface2Color">#0E1420</Color>
    <Color x:Key="Surface3Color">#1A2232</Color>
    <Color x:Key="BorderColor">#222B3A</Color>
    <Color x:Key="TextColor">#E6EAF2</Color>
    <Color x:Key="MutedColor">#9AA4B2</Color>
    <Color x:Key="DimColor">#7C8798</Color>
    <Color x:Key="AccentColor">#5EEAD4</Color>
    <Color x:Key="AccentHoverColor">#99F6E4</Color>
    <Color x:Key="AccentPressedColor">#2DD4BF</Color>
    <!-- One colour: "purple" and "success" are the same teal (Midnight). -->
    <Color x:Key="PurpleColor">#5EEAD4</Color>
    <Color x:Key="SuccessColor">#5EEAD4</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="GridLineColor">#28FFFFFF</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#133B37" />
    <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="PurpleSoft" Color="#133B37" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="GridLine" Color="{StaticResource GridLineColor}" />
    <!-- Text on teal buttons is dark (teal is light). There is no band in Midnight: ThemeManager sets the band brushes. -->
    <SolidColorBrush x:Key="OnAccent" Color="#04201C" />
    <SolidColorBrush x:Key="OnAccentMuted" Color="#0F3D38" />
    <SolidColorBrush x:Key="BandBrush" Color="Transparent" />
    <SolidColorBrush x:Key="BandText" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="BandTextMuted" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BandHover" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource SurfaceColor}" />
</ResourceDictionary>
