<UserControl x:Class="CloudSSD.Desktop.Views.RemotePcsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>
        <!-- The PCs on the left: like the side menu, a bar marks the open one. -->
        <Style x:Key="PcItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Setter Property="Margin" Value="-10,0" />
        </Style>
        <!-- Rows and column titles in the app's colours (the Windows defaults are white and blue). -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                                <ContentPresenter HorizontalAlignment="Left" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="0,5" Margin="2,0">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: the other PCs -->
        <Border Style="{StaticResource Card}" Margin="0" Padding="10,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MY PCS" Style="{StaticResource Label}" Margin="6,0,0,8" />
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Primary}" Content="+ Add a PC" Command="{Binding AddPcCommand}" Margin="0,10,0,0" />
                <Grid>
                    <ListBox ItemsSource="{Binding Pcs}" SelectedItem="{Binding SelectedPc}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PcItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="6,4"
                               Visibility="{Binding HasPcs, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Right: the chosen PC -->
        <DockPanel Grid.Column="2" Visibility="{Binding HasPcs, Converter={StaticResource Vis}}">
            <!-- Away: what was saved, and since when -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="16"
                    Padding="14,10" Margin="0,0,0,10" Visibility="{Binding ShowBanner, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Try again" Command="{Binding RefreshCommand}" Padding="10,4" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Warning}" />
                </DockPanel>
            </Border>

            <!-- That PC wants something allowed first: ask it (someone there answers) -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="16"
                    Padding="14,10" Margin="0,0,0,10" Visibility="{Binding ShowAccessAsk, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Ask for access" Command="{Binding AskAccessCommand}"
                            IsEnabled="{Binding CanAskAccess}" Padding="10,4" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding AccessText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Header and tools -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,4" />
                            <Button Content="New folder" Command="{Binding NewFolderCommand}" Padding="10,4" IsEnabled="{Binding IsOnline}" />
                            <Button Content="Send files here" Command="{Binding UploadCommand}" Padding="10,4" />
                            <Button Style="{StaticResource DangerButton}" Content="Forget" Command="{Binding ForgetPcCommand}" Padding="10,4" Margin="0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource H2}" Margin="0" />
                            <TextBlock Text="{Binding HeaderSub}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- Breadcrumbs -->
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="UpButton" DockPanel.Dock="Left" Content="&#xE74A;" FontFamily="{StaticResource IconFont}" Command="{Binding UpCommand}" Padding="8,3" ToolTip="Up" />
                        <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Ghost}" Content="{Binding Title}" Padding="4,2" Margin="0"
                                                Command="{Binding DataContext.NavigateCrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="›" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="2,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- That PC's phones, looked at through it (each phone allows it itself) -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="{Binding HasPhones, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="{Binding PhonesTitle}" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Phones}" MaxHeight="120">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="Browse files" Padding="8,3" Margin="6,0,0,0"
                                            Command="{Binding DataContext.BrowseRemotePhoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Files sent to this PC through that one (by it, or by a phone through it) -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="{Binding HasInbox, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="SENT TO THIS PC" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Inbox}" MaxHeight="160">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding CanAnswer, Converter={StaticResource Vis}}">
                                        <Button Content="Decline" Padding="8,3" Margin="6,0,0,0"
                                                Command="{Binding DataContext.DeclineOfferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Primary}" Content="Accept" Padding="8,3" Margin="6,0,0,0"
                                                Command="{Binding DataContext.AcceptOfferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Names}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="{DynamicResource Accent}"
                                                   Visibility="{Binding HasState, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Files being sent -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="{Binding HasUploads, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Clear sent" Command="{Binding ClearSentCommand}" Padding="6,2" Margin="0" />
                        <TextBlock Text="SENDING" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Uploads}" MaxHeight="120">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Drives, folders and files -->
            <ListView x:Name="List" ItemsSource="{Binding Entries}" MouseDoubleClick="OnOpen" KeyDown="OnKey"
                      Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource Text}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="OnOpenMenu" />
                        <MenuItem Header="Download to this PC" Click="OnDownloadMenu" />
                        <MenuItem x:Name="KeepMenu" Header="Keep offline" Click="OnKeepMenu" />
                        <MenuItem Header="Rename" Click="OnRenameMenu" />
                        <MenuItem Header="Delete" Click="OnDeleteMenu" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="360">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                        <Border Background="{DynamicResource PurpleSoft}" CornerRadius="10" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding KeptOffline, Converter={StaticResource Vis}}" ToolTip="Kept on this PC: opens even when that PC is off">
                                            <TextBlock Text="OFFLINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Purple}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="210" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</UserControl>
