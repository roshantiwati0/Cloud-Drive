<Window x:Class="CloudSSD.Desktop.Views.AddRemotePcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a PC" Width="560" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26,22">
        <TextBlock Text="Add a PC" Style="{StaticResource H1}" />
        <TextBlock Text="On the other PC open Cloud-SSD → Devices → + Add a device. It shows its address and a 6-digit code. Both PCs must be on the same Wi-Fi to pair."
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" x:Name="ScanButton" Content="Search again" Click="Scan" Padding="10,4" Margin="0" />
            <TextBlock Text="PCS FOUND ON THIS NETWORK" Style="{StaticResource Label}" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="Found" Height="120" DisplayMemberPath="Label" SelectionChanged="FoundChanged"
                 Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource Text}" Margin="0,0,0,4" />
        <TextBlock x:Name="ScanStatus" Style="{StaticResource Caption}" Margin="0,0,0,12" />

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ADDRESS" Style="{StaticResource Label}" />
                <TextBox x:Name="Address" FontFamily="Consolas" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="PAIRING CODE" Style="{StaticResource Label}" />
                <TextBox x:Name="Code" FontFamily="Consolas" FontSize="15" MaxLength="7" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ConnectButton" Style="{StaticResource Primary}" Content="Connect" Click="Connect" />
            <Button Content="Cancel" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
