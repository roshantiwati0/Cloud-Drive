<UserControl x:Class="CloudSSD.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0,0,14,0">

        <!-- Header: how many are online, notify switch, add a device -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="+ Add a device" Command="{Binding AddDeviceCommand}"
                        Padding="16,8" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Add a guest" Command="{Binding AddGuestCommand}" Padding="14,8" Margin="0,0,10,0"
                        VerticalAlignment="Center" ToolTip="A one-time code for someone else's phone: only what you choose, for an hour, a day or a week" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource H2}" Margin="0,0,0,6" />
                    <CheckBox Content="Notify me when a device connects" IsChecked="{Binding NotifyOnConnect}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The bridge is stopped: say so instead of showing everything as offline without a reason. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2}" CornerRadius="14" Padding="12,10" Margin="0,0,0,12"
                BorderBrush="{DynamicResource Warning}" BorderThickness="1" Visibility="{Binding BridgeOff, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add or connect" Command="{Binding OpenMobileHubCommand}" Padding="10,4" Margin="10,0,0,0" />
                <TextBlock Text="The phone bridge is off, so no device can connect. Turn it on in Devices → Add or connect."
                           TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Warning}" />
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="No devices yet. Press “+ Add a device” and pair a phone or laptop."
                   Style="{StaticResource Caption}" Margin="4,4,0,0"
                   Visibility="{Binding Cards.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />

        <!-- Cards grid: as many columns as the window has room for -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="290" Margin="0,0,14,14" Padding="16,14" CornerRadius="20"
                                Background="{DynamicResource Surface}" BorderThickness="1"
                                AllowDrop="True" Drop="OnCardDrop" DragOver="OnCardDragOver" ToolTip="Drop files here to send them to this device">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Icon, name (or the rename box), kind -->
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0"
                                            Background="{DynamicResource AccentSoft}">
                                        <TextBlock Text="{Binding KindIcon}" FontFamily="{StaticResource IconFont}" FontSize="19"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding KindText}" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SaveRenameCommand}" />
                                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Online now / last seen -->
                                <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{Binding StatusTone, Converter={StaticResource Tone}}" Margin="0,0,0,3" />
                                <!-- How it connects -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Dim}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding LinkText}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <!-- Battery and free space, as the phone last said -->
                                <TextBlock Text="{Binding VitalsText}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,3" Visibility="{Binding VitalsText, Converter={StaticResource Vis}}" />
                                <!-- What it is doing -->
                                <StackPanel Visibility="{Binding HasActivity, Converter={StaticResource Vis}}" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ActivityText}" FontSize="12" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Height="4" Margin="0,5,0,0" Minimum="0" Maximum="100" Value="{Binding ActivityPercent, Mode=OneWay}"
                                                 Visibility="{Binding HasPercent, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DetailText}" FontSize="10.5" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0" />

                                <!-- Actions -->
                                <WrapPanel Margin="0,12,0,0" Visibility="{Binding IsEditing, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                    <Button Content="Rename" Command="{Binding BeginRenameCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11.5" />
                                    <Button Content="{Binding BlockText}" Command="{Binding ToggleBlockCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11.5" />
                                    <Button Content="Permissions" Command="{Binding EditPermissionsCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11.5" />
                                    <Button Content="{Binding DeletedText}" Command="{Binding ShowDeletedCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11.5"
                                            Visibility="{Binding HasDeleted, Converter={StaticResource Vis}}" ToolTip="What it deleted on this PC; restore from the Recycle Bin" />
                                    <Button Content="Browse files" Command="{Binding BrowseCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11.5"
                                            Visibility="{Binding CanBrowse, Converter={StaticResource Vis}}" />
                                    <Button Content="Ring" Command="{Binding RingCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11.5"
                                            Visibility="{Binding CanBrowse, Converter={StaticResource Vis}}" ToolTip="Make the phone ring loudly, even on silent" />
                                    <Button Content="Send clipboard" Command="{Binding SendClipboardCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11.5"
                                            Visibility="{Binding CanBrowse, Converter={StaticResource Vis}}" />
                                    <Button Style="{StaticResource DangerButton}" Content="Remove" Command="{Binding RemoveCommand}" Padding="8,4" Margin="0,0,6,6" FontSize="11.5" />
                                </WrapPanel>
                                <WrapPanel Margin="0,12,0,0" Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                                    <Button Style="{StaticResource Primary}" Content="Save" Command="{Binding SaveRenameCommand}" Padding="10,4" Margin="0,0,6,0" FontSize="11.5" />
                                    <Button Content="Cancel" Command="{Binding CancelRenameCommand}" Padding="10,4" FontSize="11.5" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
